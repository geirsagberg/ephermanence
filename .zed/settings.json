{
  "tab_size": 2,
  "soft_wrap": "editor_width",
  "format_on_save": "on",
  "formatter": {
    "external": {
      "command": "./node_modules/.bin/vp",
      "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
    }
  },
  "languages": {
    "TypeScript": {
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.organizeImports.biome": false
      }
    },
    "TSX": {
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.organizeImports.biome": false
      }
    }
  }
}
